# Copy the values into your real env file (never commit secrets).

# Comma-separated email domains allowed to sign in (confirm with the EB; include any admin domains).
# Leave empty to accept any domain.
ALLOWED_EMAIL_DOMAINS=rmit.edu.vn,student.rmit.edu.vn

# Public URL of the frontend; used for links inside emails.
APP_URL=http://localhost:5173

# Shared secret for /api/internal/* (the scheduler sends it as x-internal-secret).
# Generate: openssl rand -hex 32
INTERNAL_SECRET=

# Resend. Leave RESEND_API_KEY empty to log emails to the console instead of sending.
RESEND_API_KEY=
# Testing without a domain: "EBMB <onboarding@resend.dev>" (delivers only to the Resend account owner).
EMAIL_FROM="EBMB <onboarding@resend.dev>"

# Deliveries sent per processor call (default 25).
EMAIL_BATCH_SIZE=25

# Audit rows older than this many days are deleted by POST /api/internal/audit/retention (default 730 = 2 years, min 30).
AUDIT_RETENTION_DAYS=730
# Set to "off" if an external cron calls /api/internal/campaigns/process
EMAIL_SCHEDULER=

# Render free plan: the service pings its own /api/health every minute so it is not stopped for idleness.
# RENDER_EXTERNAL_URL is set by Render itself; set KEEP_ALIVE_URL only to use another public url, or KEEP_ALIVE=off to disable.
KEEP_ALIVE_URL=https://project-management-tools-70gp.onrender.com
KEEP_ALIVE=

# GitHub activity (project page). Token is optional but strongly advised: without it GitHub allows
# only 60 requests/hour and private repos cannot be read. Use a fine-grained read-only token
# (Contents + Metadata: read) with access to the repos students use.
GITHUB_TOKEN=
# Minutes a cached GitHub snapshot is served before the next view refreshes it (default 15).
GITHUB_STALE_MINUTES=
