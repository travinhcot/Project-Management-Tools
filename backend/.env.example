# Copy the values into your real env file (never commit secrets).

# Public URL of the frontend; used for links inside emails.
APP_URL=http://localhost:5173

# Shared secret for /api/internal/* (the scheduler sends it as x-internal-secret).
# Generate: openssl rand -hex 32
INTERNAL_SECRET=

# Resend. Leave RESEND_API_KEY empty to log emails to the console instead of sending.
RESEND_API_KEY=
# Testing without a domain: "EBMB <onboarding@resend.dev>" (delivers only to the Resend account owner).
EMAIL_FROM="EBMB <onboarding@resend.dev>"

# Deliveries sent per processor call (default 25).
EMAIL_BATCH_SIZE=25
