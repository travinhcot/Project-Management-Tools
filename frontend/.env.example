# Copy to .env.local. Server-only: the browser never sees this URL.
# Base URL of the Express backend (backend/src/server.ts, default port 3001).
API_BASE_URL=http://localhost:3001
# Same list as the backend; used for the sign-in form check. Empty = any domain.
ALLOWED_EMAIL_DOMAINS=rmit.edu.vn,student.rmit.edu.vn
# Address behind the "Contact EBMB" link on the sign-in page (hidden when unset).
EBMB_CONTACT_EMAIL=
